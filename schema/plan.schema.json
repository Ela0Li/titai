{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://titai.local/schema/plan.schema.json",
  "title": "学习计划 / Study Plan（协议 v1.3 §9）",
  "type": "object",
  "required": ["schema", "id", "title", "members"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "计划标识符；小写字母数字与连字符"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "subtitle": { "type": "string", "maxLength": 120 },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
        "description": "成员知识包的 deck.id；数组顺序即学习顺序"
      }
    },
    "order": {
      "type": "integer",
      "description": "内置计划的默认顺序；数字小的先被当作默认计划"
    },    "primary": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "默认打开的知识包，必须属于 members"
    }
  }
}
