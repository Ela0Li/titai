# 统一换行：仓库里一律 LF，检出到 Windows 也不改成 CRLF
* text=auto eol=lf

# 脚本与文本
*.md   text eol=lf
*.json text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.kts  text eol=lf
*.java text eol=lf
*.xml  text eol=lf
gradlew text eol=lf
*.bat  text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.webp binary
*.apk binary
*.keystore binary
*.jar binary
